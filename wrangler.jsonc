{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-forward-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "BotContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "BotContainer", "name": "BOT_CONTAINER" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BotContainer"] }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
